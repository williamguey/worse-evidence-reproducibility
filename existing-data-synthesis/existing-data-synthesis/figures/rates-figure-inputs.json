  "figures": [
    {
      "all_planned_per_arm": 624,
      "caption_latex": "Choice changes under bundled endorsement and the identical cost-priority sentence, on the shared 312-case bank. Each row plans 624 choices (two orders per case); labels give observed errors/valid choices. Dots are the proportion choosing the inferior total-cost report. Tiny whiskers assign every unavailable choice both possible outcomes using the full planned denominator, not a confidence interval. In inferior-target rows this proportion is endorsement following; in the optimal-target row following equals one minus the error rate. Neutral rows have no endorsed target. The two priority rows provide the matched neutral and inferior-endorsement comparison.",
      "conditions": [
        "neutral_2",
        "bundle_bad",
        "bundle_good",
        "guard_neutral",
        "guard_bundle_bad"
      ],
      "configurations": [
        "llama_default",
        "deepseek_off",
        "luna_off"
      ],
      "figure": "endorsement-rates",
      "inline_source_sha256": "4813092cfee7a783d0a905607a6b5764ea89a82a9069a3cda7cffae3278ba275"
    },
    {
      "all_planned_per_arm": 624,
      "caption_latex": "Wording-associated error rates on the same 312-case bank. Each row plans 624 choices; labels give observed errors/valid choices. Dots and tiny whiskers use the same valid-response rates and full-plan missingness bounds as Figure~\\ref{fig:endorsement-rates}. GPT-5.6 Luna has low errors under the bundled cue but many under sponsor-only and the first preference wording. Sponsor-only, commitment-only and both preference wordings endorse the inferior report; they lack optimal-target counterparts. These are distinct observed conditions, not additive component effects or an isolated internal mechanism.",
      "conditions": [
        "neutral_2",
        "bundle_bad",
        "sponsor_bad",
        "commitment_bad",
        "preference_bad_1",
        "preference_bad_2"
      ],
